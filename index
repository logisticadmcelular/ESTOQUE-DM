function selecionarEtiqueta(codigo) {
  const item = estoque.find(p => p.codigo === codigo);
  if (!item) {
    aviso("Peça não encontrada");
    return;
  }

  etiquetasSelecionadas[codigo] = (etiquetasSelecionadas[codigo] || 0) + 1;
  desenharEtiqueta(item);
  renderizarResumoEtiquetas();
  renderizarBuscaEtiqueta();
}

function removerUmaEtiqueta(codigo) {
  if (!etiquetasSelecionadas[codigo]) return;
  etiquetasSelecionadas[codigo] -= 1;
  if (etiquetasSelecionadas[codigo] <= 0) delete etiquetasSelecionadas[codigo];
  renderizarResumoEtiquetas();
  renderizarBuscaEtiqueta();
}

function limparEtiquetasSelecionadas() {
  etiquetasSelecionadas = {};
  renderizarResumoEtiquetas();
  renderizarBuscaEtiqueta();
}

function totalEtiquetasSelecionadas() {
  return Object.values(etiquetasSelecionadas).reduce((s, n) => s + Number(n || 0), 0);
