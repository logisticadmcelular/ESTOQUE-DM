let scannerCampoStream = null;
let scannerCampoAtivo = false;
let scannerCampoInputId = null;
let scannerCampoCallback = null;
let scannerCampoAbrirBaixa = false;

async function abrirScannerParaCampo(inputId, callbackName, abrirBaixaAutomatico) {
  scannerCampoInputId = inputId;
  scannerCampoCallback = callbackName;
  scannerCampoAbrirBaixa = !!abrirBaixaAutomatico;

  if (!("BarcodeDetector" in window)) {
    alert("Seu navegador não suporta leitura automática pela câmera. Use o Chrome atualizado ou digite o código manualmente.");
    return;
  }

  try {
    const video = document.getElementById("scannerModalVideo");
    document.getElementById("scannerCampoModal").style.display = "flex";

    scannerCampoStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: "environment" }
    });

    video.srcObject = scannerCampoStream;
    scannerCampoAtivo = true;

    const detector = new BarcodeDetector({
      formats: ["qr_code", "code_128", "ean_13", "ean_8", "code_39"]
    });

    const loop = async () => {
      if (!scannerCampoAtivo) return;

      try {
        const codes = await detector.detect(video);
        if (codes.length > 0) {
          const codigo = String(codes[0].rawValue || "").trim();

          const input = document.getElementById(scannerCampoInputId);
          if (input) input.value = codigo;

          fecharScannerCampo();

          if (scannerCampoCallback && typeof window[scannerCampoCallback] === "function") {
            window[scannerCampoCallback]();
          }

          if (scannerCampoAbrirBaixa) {
            const item = estoque.find(p => String(p.codigo) === codigo);
            if (item) {
              abrirModalBaixa(item.codigo);
            } else {
              aviso("Código lido, mas peça não encontrada");
            }
          }
          return;
        }
      } catch (err) {}

      requestAnimationFrame(loop);
    };

    loop();
  } catch (err) {
    alert("Não consegui acessar a câmera. Verifique a permissão do navegador.");
    fecharScannerCampo();
  }
}

function fecharScannerCampo() {
  scannerCampoAtivo = false;

  const modal = document.getElementById("scannerCampoModal");
  if (modal) modal.style.display = "none";

  if (scannerCampoStream) {
    scannerCampoStream.getTracks().forEach(track => track.stop());
    scannerCampoStream = null;
  }
}

