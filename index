  const div = document.getElementById("resumoEtiquetas");
  if (!div) return;

  const total = totalEtiquetasSelecionadas();
  if (!total) {
    div.innerHTML = "Nenhuma etiqueta selecionada.";
    return;
  }

  const linhas = Object.entries(etiquetasSelecionadas).map(([codigo, qtd]) => {
    const item = estoque.find(p => p.codigo === codigo);
    return item ? `${qtd}x - ${item.codigo} - ${item.peca}` : `${qtd}x - ${codigo}`;
  });

  div.innerHTML = `<strong>${total} etiqueta(s) selecionada(s):</strong><br>${linhas.join("<br>")}`;
}

