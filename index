async function confirmarReposicao() {
  const item = estoque.find(p => p.codigo === codigoSelecionado);
  const qtdMov = Number(document.getElementById("reporQtd").value);
  const responsavel = document.getElementById("reporResp").value;
  const obs = document.getElementById("reporObs").value.trim();
  const novoNome = document.getElementById("reporEditPeca").value.trim().toUpperCase();
  const novoValor = Number(document.getElementById("reporEditValor").value);

  if (!item || !qtdMov || qtdMov <= 0 || !responsavel) {
    alert("Informe quantidade e responsável.");
    return;
  }

  if (!novoNome || Number.isNaN(novoValor) || novoValor < 0) {
    alert("Informe nome e valor da peça corretamente.");
    return;
  }

  const qtdAnterior = Number(item.qtd || 0);
  const novaQtd = qtdAnterior + qtdMov;
  const nomeAntigo = item.peca;
  const valorAntigo = Number(item.valor || 0);

  const res = await sb
    .from("pecas")
    .update({
      peca: novoNome,
      valor: novoValor,
      qtd: novaQtd,
      situacao: "ESTOQUE OK",
      updated_at: new Date().toISOString()
    })
    .eq("codigo", item.codigo);

  if (res.error) {
    alert("Erro ao repor estoque: " + res.error.message);
    return;
  }

  let observacaoFinal = obs || "";

  if (nomeAntigo !== novoNome || valorAntigo !== novoValor) {
    observacaoFinal += ` | Cadastro atualizado na reposição. Nome: ${nomeAntigo} > ${novoNome}. Valor: ${dinheiro(valorAntigo)} > ${dinheiro(novoValor)}.`;
  }

  await inserirMovimentacao({
    tipo: "REPOSICAO",
    responsavel,
    codigo: item.codigo,
    peca: novoNome,
    acao: "REPOR ESTOQUE",
    qtdMov,
    qtdAnterior,
    novaQtd,
    valorUnit: novoValor,
    valorTotal: novoValor * qtdMov,
    observacao: observacaoFinal
  });

  fecharModal("modalReposicao");
  await carregarTudo();
  renderizarRepor();
  renderizarEstoque();
  aviso("Reposição registrada");
}



