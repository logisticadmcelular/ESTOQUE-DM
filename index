function dentroPeriodo(h,inicio,fim) { const d=h.dataISO?new Date(h.dataISO):null; if(!d)return true; if(inicio && d<new Date(inicio+"T00:00:00"))return false; if(fim && d>new Date(fim+"T23:59:59"))return false; return true; }
function dadosRelatorioCompra() {
  const tipo=document.getElementById("relatorioTipo")?.value||"USADAS", inicio=document.getElementById("relatorioInicio")?.value||"", fim=document.getElementById("relatorioFim")?.value||"", busca=(document.getElementById("relatorioBusca")?.value||"").toLowerCase(); const mapa={};
  function add(codigo,peca,qtd,valor,situacao) { if(busca && !`${codigo} ${peca}`.toLowerCase().includes(busca)) return; if(!mapa[codigo]) { const e=estoque.find(p=>p.codigo===codigo); mapa[codigo]={codigo,peca,qtd:0,estoqueAtual:e?e.qtd:0,valor:Number(valor||(e?e.valor:0)||0),situacao:situacao||(e?e.situacao:"")}; } mapa[codigo].qtd+=Number(qtd||0); }
  if(tipo==="USADAS"||tipo==="TODOS") historico.filter(h=>h.acao==="USAR").filter(h=>dentroPeriodo(h,inicio,fim)).forEach(h=>add(h.codigo,h.peca,h.qtdMov,h.valorUnit,"USADA / VENDA"));
  if(tipo==="GARANTIAS"||tipo==="TODOS") historico.filter(h=>h.acao==="GARANTIA ABERTA").filter(h=>dentroPeriodo(h,inicio,fim)).forEach(h=>add(h.codigo,h.peca,h.qtdMov,h.valorUnit,h.garantiaStatus||"GARANTIA"));
  if(tipo==="ZERADAS"||tipo==="TODOS") estoque.filter(p=>p.qtd<=0).forEach(p=>add(p.codigo,p.peca,1,p.valor,"ESTOQUE ZERADO"));
  return Object.values(mapa).sort((a,b)=>b.qtd-a.qtd||a.peca.localeCompare(b.peca));
}
function renderizarRelatoriosCompra() {
  const tbody=document.getElementById("tabelaRelatorioCompra"); if(!tbody)return; const dados=dadosRelatorioCompra(); tbody.innerHTML=""; let qtd=0,val=0,gar=0;
  dados.forEach(i=>{ const total=i.qtd*i.valor; qtd+=i.qtd; val+=total; if(String(i.situacao).includes("GARANTIA"))gar+=i.qtd; const tr=document.createElement("tr"); tr.className=classeStatus(i.situacao); tr.innerHTML=`<td data-label="Código">${i.codigo}</td><td data-label="Peça">${i.peca}</td><td data-label="QTD usada">${i.qtd}</td><td data-label="Estoque atual">${i.estoqueAtual}</td><td data-label="Valor un.">${dinheiro(i.valor)}</td><td data-label="Total">${dinheiro(total)}</td><td data-label="Situação">${i.situacao}</td>`; tbody.appendChild(tr); });
  document.getElementById("relQtdItens").innerText=dados.length; document.getElementById("relQtdTotal").innerText=qtd; document.getElementById("relValorTotal").innerText=dinheiro(val); document.getElementById("relQtdGarantia").innerText=gar;
}
function historicoFiltrado() {
  const acao=document.getElementById("filtroAcao")?.value||"", inicio=document.getElementById("filtroDataInicio")?.value||"", fim=document.getElementById("filtroDataFim")?.value||"", texto=(document.getElementById("filtroTexto")?.value||"").toLowerCase();
  return historico.filter(h=>(!acao||h.acao===acao)&&dentroPeriodo(h,inicio,fim)&&(!texto||`${h.codigo} ${h.peca} ${h.responsavel} ${h.acao} ${h.observacao}`.toLowerCase().includes(texto)));
}
function renderizarHistorico() {
  const tbody=document.getElementById("tabelaHistorico"); tbody.innerHTML="";
  historicoFiltrado().forEach(i=>{ const tr=document.createElement("tr"); tr.innerHTML=`<td data-label="Data">${i.data}</td><td data-label="Responsável">${i.responsavel}</td><td data-label="Código">${i.codigo}</td><td data-label="Peça">${i.peca}</td><td data-label="Ação">${i.acao}</td><td data-label="QTD">${i.qtdMov}</td><td data-label="Antes">${i.qtdAnterior??""}</td><td data-label="Depois">${i.novaQtd??""}</td><td data-label="Valor un.">${dinheiro(i.valorUnit)}</td><td data-label="Total">${dinheiro(i.valorTotal)}</td><td data-label="Obs">${i.observacao||""}</td>`; tbody.appendChild(tr); });
}
function baixarArquivo(nome,conteudo) { const blob=new Blob([conteudo],{type:"text/csv;charset=utf-8;"}); const a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download=nome; a.click(); }
function exportarCSV() { const linhas=[["Data","Responsável","Código","Peça","Ação","QTD","Antes","Depois","Valor Unitário","Valor Total","Obs"]]; historicoFiltrado().forEach(h=>linhas.push([h.data,h.responsavel,h.codigo,h.peca,h.acao,h.qtdMov,h.qtdAnterior,h.novaQtd,h.valorUnit,h.valorTotal,h.observacao])); baixarArquivo("movimentacoes.csv",linhas.map(l=>l.map(v=>`"${String(v??"").replaceAll('"','""')}"`).join(";")).join("\n")); }
function exportarRelatorioCompraCSV() { const linhas=[["Código","Peça","QTD usada","Estoque atual","Valor unitário","Total","Situação"]]; dadosRelatorioCompra().forEach(i=>linhas.push([i.codigo,i.peca,i.qtd,i.estoqueAtual,i.valor,i.qtd*i.valor,i.situacao])); baixarArquivo("relatorio_para_compra.csv",linhas.map(l=>l.map(v=>`"${String(v??"").replaceAll('"','""')}"`).join(";")).join("\n")); }



async function carregarUsuariosDev() {
  await carregarUsuariosSistema();
  renderizarUsuariosDev();
}

function limparFormularioUsuarioDev() {
  document.getElementById("devUserId").value = "";
  document.getElementById("devUserNome").value = "";
  document.getElementById("devUserLogin").value = "";
  document.getElementById("devUserSenha").value = "";
  document.getElementById("devUserSenhaDev").value = "";
  document.getElementById("devUserPermissao").value = "normal";
}

function renderizarUsuariosDev() {
  if (!usuarioAtual?.dev) return;

  const div = document.getElementById("listaUsuariosDev");
  if (!div) return;

  div.innerHTML = "";

  if (!usuariosSistemaOnline.length) {
    div.innerHTML = "<p>Nenhum usuário encontrado.</p>";
    return;
  }

  usuariosSistemaOnline.forEach(u => {
    const card = document.createElement("div");
    card.className = "sale-card";
    card.innerHTML = `
      <strong>${u.nome}</strong><br>
      Login: ${u.login}<br>
      Permissão: ${u.dev ? "DESENVOLVEDOR" : "NORMAL"}<br>
      Status: ${u.ativo === false ? "INATIVO" : "ATIVO"}
      <button onclick="editarUsuarioDev('${u.id}')">Alterar</button>
      <button class="btn-red" onclick="excluirUsuarioDev('${u.id}')">Excluir</button>
    `;
    div.appendChild(card);
  });
}

function editarUsuarioDev(id) {
  const u = usuariosSistemaOnline.find(x => String(x.id) === String(id));
  if (!u) return;

  document.getElementById("devUserId").value = u.id;
  document.getElementById("devUserNome").value = u.nome || "";
  document.getElementById("devUserLogin").value = u.login || "";
  document.getElementById("devUserSenha").value = u.senha || "";
  document.getElementById("devUserSenhaDev").value = u.senha_dev || "";
  document.getElementById("devUserPermissao").value = u.dev ? "dev" : "normal";
}

async function salvarUsuarioDev() {
  if (!exigirDev()) return;

  const id = document.getElementById("devUserId").value;
  const nome = document.getElementById("devUserNome").value.trim();
  const login = document.getElementById("devUserLogin").value.trim().toLowerCase();
  const senha = document.getElementById("devUserSenha").value;
  const senhaDev = document.getElementById("devUserSenhaDev").value;
  const dev = document.getElementById("devUserPermissao").value === "dev";

  if (!nome || !login || !senha) {
    alert("Preencha nome, login e senha.");
    return;
  }

  const payload = {
    nome,
    login,
    senha,
    senha_dev: senhaDev,
    dev,
    ativo: true
  };

  let res;

  if (id) {
    res = await sb.from("usuarios").update(payload).eq("id", id);
  } else {
    res = await sb.from("usuarios").insert(payload);
  }

  if (res.error) {
    alert("Erro ao salvar usuário: " + res.error.message);
    return;
  }

  limparFormularioUsuarioDev();
  await carregarUsuariosDev();
  aviso("Usuário salvo");
}

async function excluirUsuarioDev(id) {
  if (!exigirDev()) return;

  const u = usuariosSistemaOnline.find(x => String(x.id) === String(id));
  if (!u) return;

  if (u.login === usuarioAtual.usuario) {
    alert("Você não pode excluir o usuário que está logado agora.");
    return;
  }

  if (!confirm(`Excluir usuário ${u.nome}?`)) return;

  const res = await sb.from("usuarios").delete().eq("id", id);

  if (res.error) {
    alert("Erro ao excluir usuário: " + res.error.message);
    return;
  }

  await carregarUsuariosDev();
  aviso("Usuário excluído");
}


function renderizarProdutosDev() {
  if (!usuarioAtual?.dev) return;

  const div = document.getElementById("listaProdutosDev");
  if (!div) return;

  const termo = (document.getElementById("devBuscaProduto")?.value || "").toLowerCase();
  div.innerHTML = "";

  const lista = estoque
    .filter(p => !termo || p.codigo.toLowerCase().includes(termo) || p.peca.toLowerCase().includes(termo))
    .slice(0, 50);

  if (!lista.length) {
    div.innerHTML = "<p>Nenhum produto encontrado.</p>";
    return;
  }

  lista.forEach(item => {
    const card = document.createElement("div");
    card.className = "sale-card";
    card.innerHTML = `
      <strong>${item.codigo} - ${item.peca}</strong><br>
      QTD: ${item.qtd} | Valor: ${dinheiro(item.valor)} | ${item.situacao}
      <button class="btn-red" onclick="excluirProdutoDev('${item.codigo}')">Excluir produto</button>
    `;
    div.appendChild(card);
  });
}

async function excluirProdutoDev(codigo) {
  if (!exigirDev()) return;

  const item = estoque.find(p => p.codigo === codigo);
  if (!item) {
    alert("Produto não encontrado.");
    return;
  }

  if (!confirm(`Excluir definitivamente o produto?\n\n${item.codigo} - ${item.peca}`)) return;

  const res = await sb.from("pecas").delete().eq("codigo", codigo);
  if (res.error) {
    alert("Erro ao excluir: " + res.error.message);
    return;
  }

  await inserirMovimentacao({
    tipo: "DESENVOLVEDOR",
    responsavel: usuarioAtual.nome.toUpperCase(),
    codigo: item.codigo,
    peca: item.peca,
    acao: "EXCLUIU PRODUTO",
    qtdMov: item.qtd,
    qtdAnterior: item.qtd,
    novaQtd: 0,
    valorUnit: item.valor,
    valorTotal: item.valor * item.qtd,
    observacao: "Produto excluído pelo desenvolvedor"
  });

  await carregarTudo();
  renderizarProdutosDev();
  aviso("Produto excluído");
}

async function zerarTodoEstoque() {
  if (!exigirDev()) return;

  const texto = prompt('Para confirmar, digite exatamente: ZERAR ESTOQUE');
  if (texto !== "ZERAR ESTOQUE") {
    aviso("Ação cancelada");
    return;
  }

  const res = await sb.from("pecas").update({
    qtd: 0,
    situacao: "ESTOQUE ZERADO",
    updated_at: new Date().toISOString()
  }).neq("codigo", "__nenhum__");

  if (res.error) {
    alert("Erro ao zerar estoque: " + res.error.message);
    return;
  }

  await inserirMovimentacao({
    tipo: "DESENVOLVEDOR",
    responsavel: usuarioAtual.nome.toUpperCase(),
    codigo: "TODOS",
    peca: "TODOS OS PRODUTOS",
    acao: "ZEROU TODO O ESTOQUE",
    qtdMov: 0,
    qtdAnterior: "",
    novaQtd: 0,
    valorUnit: 0,
    valorTotal: 0,
    observacao: "Todo estoque foi zerado pelo desenvolvedor"
  });

  await carregarTudo();
  aviso("Todo estoque foi zerado");
}



